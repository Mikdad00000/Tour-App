rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.adminId == uid()
        && uid() in request.resource.data.memberIds;
      allow update: if signedIn() && uid() == resource.data.adminId;

      match /deposits/{depositId} {
        allow read: if signedIn() && uid() in get(/databases/$(db)/documents/trips/$(tripId)).data.memberIds;
        allow create: if signedIn() && uid() == request.resource.data.userId;
        allow update: if signedIn()
          && uid() == get(/databases/$(db)/documents/trips/$(tripId)).data.adminId;
      }

      match /expenses/{expenseId} {
        allow read: if signedIn() && uid() in get(/databases/$(db)/documents/trips/$(tripId)).data.memberIds;
        // shared/partial: only admin; individual/peer_loan: paidBy must be self
        allow create: if signedIn() && (
          (request.resource.data.type in ['shared', 'partial']
              && uid() == get(/databases/$(db)/documents/trips/$(tripId)).data.adminId)
          || (request.resource.data.type in ['individual', 'peer_loan']
              && uid() == request.resource.data.paidBy)
        );
        // peer_loan: lender can mark repaid; admin can edit anything
        allow update: if signedIn() && (
          uid() == get(/databases/$(db)/documents/trips/$(tripId)).data.adminId
          || (resource.data.type == 'peer_loan' && uid() == resource.data.paidBy)
        );
      }

      match /budgets/{userId} {
        allow read: if signedIn() && uid() in get(/databases/$(db)/documents/trips/$(tripId)).data.memberIds;
        allow write: if signedIn() && uid() == userId;
      }

      match /activity/{activityId} {
        allow read: if signedIn() && uid() in get(/databases/$(db)/documents/trips/$(tripId)).data.memberIds;
        allow write: if false; // server-only via Cloud Functions
      }
    }
  }
}
